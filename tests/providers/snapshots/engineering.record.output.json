{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "measurement": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "enum": [
            "mass",
            "volume",
            "length",
            "thickness"
          ],
          "type": "string"
        },
        "unit": {
          "enum": [
            "kg",
            "m3",
            "mm3",
            "m",
            "mm"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "quantity",
        "value",
        "unit"
      ],
      "type": "object"
    },
    "resource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "mock://plate"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "pattern": "^r[1-9][0-9]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "provider",
        "revision"
      ],
      "type": "object"
    },
    "stored": {
      "const": true
    }
  },
  "required": [
    "stored",
    "measurement",
    "resource"
  ],
  "type": "object"
}
