{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-process-spec:schema:requirements:0.1.0-draft.1",
  "title": "Experimental engineering process requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "profile", "process", "requiredFeatures", "bindings", "operations", "resources", "job", "acceptance"],
  "properties": {
    "format": {"const": "epx-requirements"},
    "version": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "entrypoint"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "pattern": "^[^#]+#main$"}
      }
    },
    "requiredFeatures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "bindings": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/binding"}},
    "operations": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^main/[A-Za-z][A-Za-z0-9_-]*$"}, "additionalProperties": {"$ref": "#/$defs/operation"}},
    "resources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/resource"}},
    "job": {"$ref": "#/$defs/path"},
    "acceptance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^:]+$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "application", "protocolVersion", "executionPlatforms"],
      "properties": {
        "implementation": {
          "type": "object", "additionalProperties": false, "required": ["id", "revision"],
          "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "artifactSha256": {"$ref": "#/$defs/digest"}}
        },
        "application": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
        },
        "protocolVersion": {"type": "string", "minLength": 1},
        "executionPlatforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["binding", "tool", "toolContract", "effect"],
      "properties": {
        "binding": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "toolContract": {"$ref": "#/$defs/path"},
        "effect": {"enum": ["read-only", "mutation"]}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["binding", "uri", "revision"],
      "properties": {"binding": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "node", "valuePointer", "unitPointer", "quantityPointer", "quantity", "unit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "node": {"type": "string", "pattern": "^main/[A-Za-z][A-Za-z0-9_-]*$"},
        "valuePointer": {"type": "string", "pattern": "^/"},
        "unitPointer": {"type": "string", "pattern": "^/"},
        "quantityPointer": {"type": "string", "pattern": "^/"},
        "quantity": {"enum": ["length", "mass", "volume", "density"]},
        "unit": {"type": "string", "minLength": 1},
        "expected": {"type": "number"},
        "absoluteTolerance": {"type": "number", "minimum": 0},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      },
      "oneOf": [
        {"required": ["expected", "absoluteTolerance"], "not": {"anyOf": [{"required": ["minimum"]}, {"required": ["maximum"]}]}},
        {"required": ["minimum", "maximum"], "not": {"anyOf": [{"required": ["expected"]}, {"required": ["absoluteTolerance"]}]}}
      ]
    }
  }
}
