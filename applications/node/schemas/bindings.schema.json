{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-process-spec:schema:bindings:0.1.0-draft.1",
  "title": "Receiving configuration, never embedded as process authority",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "bindings"],
  "properties": {
    "format": {"const": "epx-bindings"},
    "version": {"const": "0.1.0-draft.1"},
    "bindings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/localBinding"}}
  },
  "$defs": {
    "localBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "application", "transport", "trust"],
      "properties": {
        "implementation": {
          "type": "object", "additionalProperties": false, "required": ["id", "revision"],
          "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}
        },
        "application": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
        },
        "transport": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind", "command", "arguments"], "properties": {
            "kind": {"const": "stdio"}, "command": {"type": "string", "minLength": 1}, "arguments": {"type": "array", "items": {"type": "string"}}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": {
            "kind": {"const": "http"}, "url": {"type": "string", "pattern": "^https?://"}, "tokenEnv": {"type": "string", "minLength": 1}
          }}
        ]},
        "trust": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": {
            "kind": {"const": "launcher-sha256"}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["kind", "subject", "description"], "properties": {
            "kind": {"const": "configured-service"}, "subject": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}
          }}
        ]}
      }
    }
  }
}
